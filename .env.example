# Mesail local stack settings, read by docker-compose.yml and scripts/floci/*.sh.
# Copy to .env only to change a default. Every value here is for local development:
# never reuse these passwords anywhere else, and never commit .env.

# Public origin of the router, as the Mac sees it. Keycloak issues tokens with this origin.
MESAIL_PUBLIC_URL=http://127.0.0.1:18080
MESAIL_ROUTER_PORT=18080

# Origin in every token's issuer: <origin>/idp/realms/<domain>. The apps' oidc.issuer uses the same.
MESAIL_ISSUER_ORIGIN=https://mesail.localhost

# Keycloak port on the Mac (127.0.0.1 only).
MESAIL_KEYCLOAK_PORT=18180

# Client secrets are generated for each run and never written to the logs. To use your own (for example
# to match a Keycloak you run yourself), point MESAIL_SECRETS_FILE at a file of NAME=value lines with:
# MESAIL_IDENTITY_CLIENT_SECRET, MESAIL_SERVICE_SECRET, MESAIL_ACCOUNT_CLIENT_SECRET,
# MESAIL_KEYCLOAK_DIRECTORY_SECRET, KC_BOOTSTRAP_ADMIN_CLIENT_SECRET and MESAIL_LINK_SECRET.
# MESAIL_SECRETS_FILE=

# Engine: mesail (the dev host, Floci on 14566) or colima (Floci on 4566).
# MESAIL_VM=mesail
