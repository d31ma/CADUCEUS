# Mesail local stack settings, read by docker-compose.yml and scripts/floci/*.sh.
# Copy to .env only to change a default. Every value here is for local development:
# never reuse these passwords anywhere else, and never commit .env.

# Public origin of the router, as the Mac sees it. Keycloak issues tokens with this origin.
MESAIL_PUBLIC_URL=http://127.0.0.1:18080
MESAIL_ROUTER_PORT=18080

# Keycloak admin port on the Mac (127.0.0.1 only) and its bootstrap admin.
MESAIL_KEYCLOAK_PORT=18180
MESAIL_KEYCLOAK_ADMIN=admin
MESAIL_KEYCLOAK_ADMIN_PASSWORD=mesail-dev-admin
# Keycloak image. Defaults to upstream Keycloak until the Keycloak stage of the Dockerfile exists.
# MESAIL_KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.2

# Password of every seeded test user (ana, bo, eve, carol, operator).
MESAIL_SEED_PASSWORD=mesail-dev-password

# Floci (local AWS) endpoint on the Mac. Colima: 4566. mesail VM: 14566.
MESAIL_FLOCI_PORT=4566
