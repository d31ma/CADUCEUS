# ── CADUCEUS Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ── Server ───────────────────────────────────────────────────────────────

# Bind address (default: 0.0.0.0 in Docker, 127.0.0.1 locally)
HOST=0.0.0.0

# HTTP port (default: 8080 in Docker)
PORT=8080

# ── Tachyon workspace ─────────────────────────────────────────────────────────────

YON_ROUTES_PATH=server/routes
YON_PAGES_PATH=client/pages
YON_COMPONENTS_PATH=client/components
YON_ASSETS_PATH=client/shared/assets
YON_SHARED_DATA_PATH=client/shared/data
YON_SHARED_SCRIPTS_PATH=client/shared/scripts
YON_SHARED_STYLES_PATH=client/shared/styles

# ── Database (Fylo) ──────────────────────────────────────────────────────

# Local file-backed persistence directory (default: /data/caduceus in Docker).
# Its parent must be writable so FYLO can create the adjacent root lease.
FYLO_ROOT=./.data
FYLO_SCHEMA=db/schemas
FYLO_INDEX_BACKEND=local-fs
FYLO_INCOMING_ROOT=./.data/.caduceus-incoming
# The container entrypoint generates this process-local bridge secret. Set it
# explicitly only when launching `caduceus fylo-bridge` and Tachyon separately.
# FYLO_BRIDGE_SECRET=at-least-32-random-characters
FYLO_BRIDGE_ADDRESS=127.0.0.1:9876
FYLO_REQUEST_TIMEOUT=10s
FYLO_MAX_REQUEST_BYTES=33554432
FYLO_MAX_RESPONSE_BYTES=33554432
FYLO_RESTART_LIMIT=3
FYLO_MAX_ATTACHMENT_BYTES=52428800
FYLO_ATTACHMENT_QUOTA_BYTES=10737418240
# Provider passwords are encrypted before FYLO persistence. Generate a stable
# 32-byte key (for example: `openssl rand -base64 32`) and store the JSON value
# in your deployment secret manager. Keep old versions while rotating so
# existing credentials remain decryptable; the active version encrypts writes.
EXTERNAL_ACCOUNT_CREDENTIAL_KEYS={"1":"replace-with-a-base64-encoded-32-byte-key"}
EXTERNAL_ACCOUNT_ACTIVE_KEY=1
EXTERNAL_ACCOUNT_CONNECTION_TIMEOUT=15s
# Optional comma-separated canonical private/loopback CIDRs that connected
# IMAP/SMTP endpoints may resolve to. Empty blocks private-network SSRF.
# EXTERNAL_ACCOUNT_PRIVATE_CIDRS=10.20.0.0/16
# Optional Microsoft 365 / Outlook OAuth. Register one confidential web app
# whose exact redirect URI is this deployment's Settings URL. All three
# client values are atomic; omitting them leaves Microsoft choices disabled.
# MICROSOFT_OAUTH_CLIENT_ID=00000000-0000-0000-0000-000000000000
# MICROSOFT_OAUTH_CLIENT_SECRET=replace-with-a-secret-from-microsoft-entra
# MICROSOFT_OAUTH_TENANT=organizations
# MICROSOFT_OAUTH_REDIRECT_URI=https://mail.example.com/settings
# Optional Gmail / Google Workspace OAuth. Register one confidential web app
# and the exact Settings callback. All three values are atomic.
# GOOGLE_OAUTH_CLIENT_ID=example.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=replace-with-a-google-oauth-client-secret
# GOOGLE_OAUTH_REDIRECT_URI=https://mail.example.com/settings
# Absolute path to the released Fylo executable for the Go owner.
# FYLO_BINARY=/absolute/path/to/FYLO/dist-bin/fylo
# Opt in only with a Fylo build that supports issue #68 machine access.
# The service account must be allowed to assign the generated numeric domain GIDs.
FYLO_POSIX_ACCESS=false

# ── Identity (required) ──────────────────────────────────────────────────

# CADUCEUS makes no authentication decision. One SESAME engine, owned by the
# Go runtime, makes them all. See docs/PHASE3_AUTH.md.

# Absolute path to the qualified SESAME release executable. Its SHA-256 must
# match a digest pinned in runtime.lock.json or the runtime refuses to start.
# SESAME_BINARY=/usr/local/bin/sesame

# Deployment directory created by `caduceus auth init`. It holds the signing,
# secrets, and snapshot keys and the engine's own FYLO root, and it is never
# created implicitly: minting a new signing key on a volume whose keys failed
# to mount would end every session with no explanation. Back it up.
# SESAME_DEPLOYMENT=/data/sesame

# The https base URL tokens are issued under.
# SESAME_ISSUER=https://mail.example.com

# Exact redirect URI registered for the first-party client. Defaults to
# PUBLIC_URL/auth/callback. No browser is ever sent there — the authorization
# code flow runs in-process — but SESAME matches redirect URIs exactly.
# SESAME_REDIRECT_URI=https://mail.example.com/auth/callback

# Session bound (1m–720h) and per-operation deadline (100ms–2m).
SESAME_SESSION_LIFETIME=12h
SESAME_REQUEST_TIMEOUT=10s

# passkey-first accepts a user-verified passkey alone; password-and-passkey
# additionally requires the password factor. Both require MFA assurance.
CADUCEUS_AUTH_POLICY=passkey-first

# ── Security (required) ──────────────────────────────────────────────────

# HMAC key for inbound email webhook authentication
INBOUND_WEBHOOK_SECRET=change-me-too

# Dedicated encryption key for per-recipient open/click capabilities. Use a
# unique random value of at least 32 characters; do not reuse session keys.
TRACKING_SECRET=change-me-to-a-separate-random-secret

# Canonical credential-free public origin embedded in delivered tracking URLs.
# HTTPS is required in production. Defaults to SESAME_ISSUER when omitted.
CADUCEUS_PUBLIC_URL=https://mail.example.com

# ── Spam filtering ───────────────────────────────────────────────────────

# Inbound mail is quarantined to the `spam` folder when its score reaches this
# threshold. The score combines SPF/DKIM/DMARC results and X-Spam-* headers
# from the built-in receiver with light content heuristics.
# Defaults to 5.0 (the SpamAssassin convention).
# SPAM_SCORE_THRESHOLD=5

# Set to true to disable spam classification entirely (everything → inbox).
# SPAM_FILTER_DISABLED=false

# One-time domain/admin bootstrap. Safe to leave set across restarts:
# existing domains are preserved and existing admin users are updated
# additively with any new domain.
# CADUCEUS_BOOTSTRAP_DOMAINS=[{"domain":"example.com","adminEmail":"admin@example.com"}]

# ── Web Push Notifications ───────────────────────────────────────────────

# Generate VAPID keys with: bun node_modules/.bin/web-push generate-vapid-keys
# Required in production unless WEB_PUSH_DISABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact URI for Web Push (e.g. mailto:admin@example.com)
VAPID_SUBJECT=

# Set to true to disable push delivery (e.g. in dev / controlled environments)
# WEB_PUSH_DISABLED=true

# ── Standalone mail server (true MTA, no external mail service) ────────────
# Turn CADUCEUS into a real mail server that RECEIVES mail directly over SMTP
# and SENDS it straight to each recipient's MX. Requires a host that allows
# inbound + outbound TCP port 25, and DNS records for your domain (MX → this
# host, plus SPF/DKIM/DMARC) and a matching PTR/reverse-DNS on the server IP.
#
# Receiving: run the built-in inbound SMTP server (listens on :25 and feeds the
# canonical inbound pipeline used by the application.
# MAIL_SERVER_ENABLED=true
# SMTP_INBOUND_PORT=25              # 25 in prod; use e.g. 2525 for unprivileged dev
# SMTP_INBOUND_HOST=0.0.0.0
# MAIL_HOSTNAME=mail.your-domain.com   # your FQDN; used in EHLO + SMTP banner
# SMTP_MAX_SIZE=11534336            # max inbound/submitted message size in bytes (11 MiB; the server reads at most 12 MiB per request)
# TLS for inbound STARTTLS + submission (recommended). Two options:
#
# 1) Automatic (Let's Encrypt / ACME). Provisions and renews a cert for
#    MAIL_HOSTNAME on its own — answers the HTTP-01 challenge on port 80, so
#    the host must allow inbound TCP 80. Writes to MAIL_TLS_DIR (default
#    /data/tls) unless MAIL_TLS_CERT_FILE/KEY_FILE are set.
# MAIL_ACME_ENABLED=true
# MAIL_ACME_EMAIL=admin@your-domain.com   # ACME account contact (required)
# MAIL_ACME_STAGING=true                  # use LE staging while testing (untrusted certs, no rate limits)
# MAIL_ACME_HTTP_PORT=80                  # HTTP-01 challenge listener
# MAIL_TLS_DIR=/data/tls
#
# 2) Manual — bring your own PEM (e.g. from certbot on the host):
# MAIL_TLS_CERT_FILE=/etc/letsencrypt/live/mail.your-domain.com/fullchain.pem
# MAIL_TLS_KEY_FILE=/etc/letsencrypt/live/mail.your-domain.com/privkey.pem
#
# MAIL_AUTH_VERIFY=on   # SPF/DKIM/DMARC verification on inbound (set "off" to skip)
#
# Sending is direct-to-MX in production. Sign outbound with DKIM so other
# servers accept it — publish the public key at <selector>._domainkey.<domain>.
# DKIM_DOMAIN=your-domain.com
# DKIM_SELECTOR=default
# DKIM_PRIVATE_KEY_FILE=/etc/caduceus/dkim/private.pem   # or DKIM_PRIVATE_KEY=<pem>
# SMTP_FROM=postmaster@your-domain.com
# SMTP_TLS_POLICY=opportunistic      # use STARTTLS when offered; "require" fails closed without validated TLS
#
# Outbound delivery worker: drives the retry/backoff/bounce queue. Runs
# automatically under `entry.mjs serve`; set to "off" to disable.
# OUTBOUND_QUEUE_WORKER=on
# OUTBOUND_QUEUE_INTERVAL_MS=30000    # how often to process due messages
# OUTBOUND_QUEUE_TIMEOUT_MS=60000     # local API timeout for one queue pass
# SNOOZE_WORKER=on                    # automatically return due conversations
# SNOOZE_INTERVAL_MS=30000            # how often to scan active snoozes
# SNOOZE_TIMEOUT_MS=60000             # local API timeout for one snooze pass
# REMINDER_WORKER=on                  # surface due no-reply follow-ups
# REMINDER_INTERVAL_MS=30000          # how often to scan pending reminders
# REMINDER_TIMEOUT_MS=60000           # local API timeout for one reminder pass
# PROVIDER_NOTIFICATION_WORKER=on     # deliver durable connected-account alerts
# PROVIDER_NOTIFICATION_INTERVAL_MS=15000
# PROVIDER_NOTIFICATION_TIMEOUT_MS=60000
#
# Secret-free lifecycle and queue measurements are emitted as JSON under the
# `[mail:status]` log prefix. Set the interval to 0 to keep startup/shutdown
# records but disable periodic records.
# MAIL_STATUS_INTERVAL_MS=300000
#
# Message submission — let standard clients (Thunderbird/Apple Mail) SEND via
# CADUCEUS. Requires TLS (MAIL_TLS_*) and users signing in with email+password.
# MAIL_SUBMISSION_ENABLED=true
# SMTP_SUBMISSION_PORT=587           # STARTTLS submission
# SMTP_SUBMISSION_TLS_PORT=465       # optional implicit-TLS submission

# ── Test / Development ───────────────────────────────────────────────────

# Enable test-only routes (e.g. seed endpoints) — only in NODE_ENV=test
# CADUCEUS_ENABLE_TEST_ROUTES=true
# NODE_ENV=test
