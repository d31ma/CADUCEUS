# Mesail local stack settings, read by docker-compose.yml and scripts/floci/*.sh.
# Copy to .env only to change a default. Every value here is for local development:
# never reuse these passwords anywhere else, and never commit .env.

# Public origin of the router, as the Mac sees it.
MESAIL_PUBLIC_URL=http://127.0.0.1:18080
MESAIL_ROUTER_PORT=18080

# Sign-ins per minute per client address at the router. The production default is 10;
# the test stacks use 1000, because the blackbox tests sign in many times.
# MESAIL_ROUTER_RATE_LIMIT=1000

# Keycloak port on the Mac (127.0.0.1 only). Only the services talk to Keycloak; its issuer
# is http://keycloak.localhost:18180/idp/realms/mesail inside the stack.
MESAIL_KEYCLOAK_PORT=18180

# Secrets are generated for each run and never written to the logs. To use your own, point
# MESAIL_SECRETS_FILE at a file of NAME=value lines with every name in stack.json "generatedSecrets":
#   MESAIL_IDENTITY_CLIENT_SECRET, MESAIL_ACCOUNT_CLIENT_SECRET, MESAIL_KEYCLOAK_DIRECTORY_SECRET,
#   MESAIL_SERVICE_CLIENT_SECRET (identity's POST /service-token secret; letters and digits only),
#   MESAIL_LINK_SECRET, MESAIL_REALTIME_GATEWAY_SECRET (at least 32 characters each),
#   MESAIL_IDENTITY_SESSION_KEY (base64 of 32 random bytes: openssl rand -base64 32),
#   MESAIL_IDENTITY_SIGNING_KEY (base64 of the PKCS #8 DER of a P-256 key, one line:
#     openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | openssl pkcs8 -topk8 -nocrypt -outform DER | base64)
# MESAIL_SECRETS_FILE=
#
# Key rotation only (not generated): identity also reads YON_IDENTITY_SIGNING_PREVIOUS (the old
# signing key, so tokens it signed still pass) and YON_SERVICE_CLIENT_PREVIOUS (the old service
# secret). While you rotate, put them in apps/identity/.env (native run) or in the identity
# function's environment (Lambda).

# Engine: mesail (the dev host, Floci on 14566) or colima (Floci on 4566).
# MESAIL_VM=mesail
