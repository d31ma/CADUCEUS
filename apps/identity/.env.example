YON_IDENTITY_CLIENT_SECRET=<secret of the Keycloak client mesail-identity>
YON_IDENTITY_ACCOUNT_SECRET=<secret of the Keycloak client mesail-account>
YON_IDENTITY_SESSION_KEY=<base64 of 32 random bytes>
YON_IDENTITY_SIGNING_KEY=<base64 of the PKCS #8 DER of a P-256 key, one line>
YON_SERVICE_CLIENT_SECRET=<the mesail-service secret>
