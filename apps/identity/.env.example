YON_IDENTITY_CLIENT_SECRET=<secret of the Keycloak client mesail-identity>
YON_IDENTITY_ACCOUNT_SECRET=<secret of the Keycloak client mesail-account>
YON_IDENTITY_SESSION_KEY=<base64 of 32 random bytes>
YON_IDENTITY_SIGNING_KEY=<base64 of the PKCS #8 DER of a P-256 key, one line>
YON_IDENTITY_SIGNING_PREVIOUS=<only during a key rotation: the key that signed before, same format>
YON_SERVICE_CLIENT_SECRET=<the secret apps send to POST /service-token (MESAIL_SERVICE_CLIENT_SECRET)>
YON_SERVICE_CLIENT_PREVIOUS=<only during a rotation: the service secret that is still accepted>
