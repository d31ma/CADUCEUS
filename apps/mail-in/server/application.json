{
  "server": {
    "host": "127.0.0.1",
    "port": 8109,
    "environment": [
      "AWS_*"
    ]
  },
  "oidc": {
    "issuer": "https://mesail.localhost/idp/realms/{realm}",
    "jwks": "http://keycloak:8080/idp/realms/{realm}/protocol/openid-connect/certs",
    "audience": "mesail-api",
    "keycloak": "http://keycloak:8080/idp/realms/{realm}/protocol/openid-connect"
  },
  "outbox": {
    "producer": "mail-in",
    "subscribers": [
      {
        "name": "messaging",
        "url": "http://127.0.0.1:8104/api/v1/messaging/events"
      }
    ],
    "retry": {
      "basedelayseconds": 5,
      "maxdelayseconds": 900,
      "maxattempts": 12
    }
  },
  "outgoing": {
    "hosts": [
      "127.0.0.1",
      "keycloak",
      "directory.localhost",
      "floci"
    ]
  },
  "names": {
    "words": [
      "dkim",
      "dmarc",
      "helo",
      "mx",
      "spf"
    ]
  },
  "mailin": {
    "directory": "http://directory.localhost:8102",
    "blobs": {
      "bucket": "mesail-raw",
      "link": {
        "seconds": 300
      }
    }
  }
}
