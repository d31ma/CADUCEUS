YON_DATASOURCE_DRIVER=fylo
YON_DATASOURCE_URL=fylo:///absolute/path/to/an/existing/fylo/root
YON_REALTIME_GATEWAY_URL=http://127.0.0.1:8117
YON_REALTIME_GATEWAY_SECRET=at-least-32-characters-shared-with-the-gateway
# YON_SERVICE_CLIENT_SECRET is identity's service-token secret (identity's POST /api/v1/identity/service-token).
# There is no Keycloak mesail-service client any more.
YON_SERVICE_CLIENT_SECRET=the-mesail-service-client-secret
