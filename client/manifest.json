{
  "name": "HERMES Mail",
  "short_name": "HERMES",
  "description": "Secure multi-domain mail for teams.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "browser"
  ],
  "orientation": "any",
  "background_color": "#0d0d0d",
  "theme_color": "#0d0d0d",
  "categories": [
    "productivity",
    "business"
  ],
  "icons": [
    {
      "src": "/shared/assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/shared/assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/shared/assets/maskable-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Inbox",
      "short_name": "Inbox",
      "url": "/inbox",
      "icons": [
        {
          "src": "/shared/assets/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Compose",
      "short_name": "Compose",
      "url": "/compose",
      "icons": [
        {
          "src": "/shared/assets/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "protocol_handlers": [
    {
      "protocol": "mailto",
      "url": "/compose?protocol=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/inbox?source=file-handler",
      "accept": {
        "message/rfc822": [
          ".eml"
        ]
      }
    }
  ],
  "share_target": {
    "action": "/compose",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "shareTitle",
      "text": "shareText",
      "url": "shareUrl"
    }
  },
  "tac": {
    "names": {
      "words": [
        "caduceus",
        "mfa",
        "totp",
        "passkey",
        "passkeys",
        "eml",
        "mbox",
        "mailto",
        "pwa",
        "bcc",
        "unsnooze",
        "mcp",
        "imap",
        "smtp",
        "dav",
        "carddav",
        "caldav",
        "onboarding",
        "oauth",
        "vapid",
        "github",
        "webauthn",
        "gmail"
      ]
    },
    "styles": [
      "/shared/assets/duvay/duvay.min.css",
      "/shared/assets/styles.css",
      "/shared/assets/themes.css"
    ],
    "styleSources": {
      "/shared/assets/duvay/duvay.min.css": {
        "kind": "vendor",
        "package": "duvay",
        "version": "0.0.0",
        "license": "UNLICENSED",
        "sha256": "67f77f4c8beaa6c3372af0cc54ff127cdeaa4ad9f1314a2aea48a58a1ade9027"
      },
      "/shared/assets/styles.css": {
        "kind": "foundation"
      },
      "/shared/assets/themes.css": {
        "kind": "foundation"
      }
    },
    "scripts": [
      "/shared/assets/config.js",
      "/shared/assets/duvay/duvay-wc.min.js",
      "/shared/scripts/page-setup.js"
    ],
    "scriptSources": {
      "/shared/assets/duvay/duvay-wc.min.js": {
        "package": "duvay",
        "version": "0.0.0",
        "license": "UNLICENSED",
        "sha256": "67f441e7d55652f6f17a8205e8d8249b980e85533313f79a9934898dfc51a763"
      }
    },
    "browserApis": [
      "clipboard",
      "notifications"
    ]
  }
}
