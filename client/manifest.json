{
  "name": "HERMES Mail",
  "short_name": "HERMES",
  "description": "Secure multi-domain mail for teams.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "browser"
  ],
  "orientation": "any",
  "background_color": "#0d0d0d",
  "theme_color": "#0d0d0d",
  "categories": [
    "productivity",
    "business"
  ],
  "icons": [
    {
      "src": "/shared/assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/shared/assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/shared/assets/maskable-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Inbox",
      "short_name": "Inbox",
      "url": "/inbox",
      "icons": [
        {
          "src": "/shared/assets/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Compose",
      "short_name": "Compose",
      "url": "/compose",
      "icons": [
        {
          "src": "/shared/assets/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "protocol_handlers": [
    {
      "protocol": "mailto",
      "url": "/compose?protocol=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/inbox?source=file-handler",
      "accept": {
        "message/rfc822": [
          ".eml"
        ]
      }
    }
  ],
  "share_target": {
    "action": "/compose",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "shareTitle",
      "text": "shareText",
      "url": "shareUrl"
    }
  },
  "tac": {
    "browserApis": [
      "clipboard"
    ],
    "names": {
      "words": [
        "mcp",
        "imap",
        "smtp",
        "dav",
        "carddav",
        "caldav",
        "onboarding",
        "bcc",
        "unsnooze",
        "oauth",
        "totp",
        "vapid",
        "github",
        "passkey",
        "passkeys",
        "webauthn",
        "gmail"
      ]
    }
  }
}
