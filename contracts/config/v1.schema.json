{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caduceus.del.ma/contracts/config/v1.schema.json",
  "title": "CADUCEUS v1 environment configuration",
  "type": "object",
  "required": [
    "INBOUND_WEBHOOK_SECRET",
    "FYLO_ROOT",
    "FYLO_BINARY",
    "SESAME_BINARY",
    "SESAME_DEPLOYMENT",
    "SESAME_ISSUER",
    "EXTERNAL_ACCOUNT_CREDENTIAL_KEYS",
    "EXTERNAL_ACCOUNT_ACTIVE_KEY"
  ],
  "properties": {
    "HOST": { "type": "string", "default": "127.0.0.1" },
    "PORT": { "$ref": "#/$defs/port", "default": "8080" },
    "METRICS_HOST": { "enum": ["127.0.0.1", "::1", "localhost"], "default": "127.0.0.1" },
    "METRICS_PORT": { "$ref": "#/$defs/port", "default": "9090" },
    "STATIC_DIR": { "type": "string", "minLength": 1, "default": "build/static" },
    "RUNTIME_LOCK": { "type": "string", "minLength": 1, "default": "runtime.lock.json" },
    "SHUTDOWN_TIMEOUT": { "$ref": "#/$defs/duration", "default": "10s" },
    "PUBLIC_URL": { "type": "string", "format": "uri" },
    "FYLO_ROOT": { "type": "string", "minLength": 1 },
    "FYLO_SCHEMA": { "type": "string", "default": "db/schemas" },
    "FYLO_BINARY": { "type": "string", "minLength": 1 },
    "FYLO_POSIX_ACCESS": { "$ref": "#/$defs/boolean", "default": "false" },
    "FYLO_BRIDGE_ADDRESS": {
      "type": "string",
      "pattern": "^(?:127\\.0\\.0\\.1|\\[::1\\]):[0-9]{1,5}$",
      "default": "127.0.0.1:9876"
    },
    "FYLO_BRIDGE_SECRET": { "$ref": "#/$defs/bridgeSecret" },
    "FYLO_INCOMING_ROOT": { "type": "string", "minLength": 1 },
    "FYLO_REQUEST_TIMEOUT": { "$ref": "#/$defs/duration", "default": "10s" },
    "FYLO_MAX_REQUEST_BYTES": { "$ref": "#/$defs/positiveInteger", "default": "1048576" },
    "FYLO_MAX_RESPONSE_BYTES": { "$ref": "#/$defs/positiveInteger", "default": "8388608" },
    "FYLO_RESTART_LIMIT": { "$ref": "#/$defs/positiveInteger", "default": "3" },
    "FYLO_MAX_ATTACHMENT_BYTES": { "$ref": "#/$defs/positiveInteger", "default": "52428800" },
    "FYLO_ATTACHMENT_QUOTA_BYTES": { "$ref": "#/$defs/positiveInteger", "default": "10737418240" },
    "EXTERNAL_ACCOUNT_CREDENTIAL_KEYS": { "$ref": "#/$defs/credentialKeyring" },
    "EXTERNAL_ACCOUNT_ACTIVE_KEY": { "$ref": "#/$defs/positiveInteger" },
    "EXTERNAL_ACCOUNT_CONNECTION_TIMEOUT": { "$ref": "#/$defs/duration", "default": "15s" },
    "EXTERNAL_ACCOUNT_PRIVATE_CIDRS": { "type": "string", "maxLength": 2048 },
    "MICROSOFT_OAUTH_CLIENT_ID": { "type": "string", "minLength": 1, "maxLength": 256 },
    "MICROSOFT_OAUTH_CLIENT_SECRET": { "type": "string", "minLength": 16, "maxLength": 8192, "writeOnly": true },
    "MICROSOFT_OAUTH_TENANT": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$", "default": "organizations" },
    "MICROSOFT_OAUTH_REDIRECT_URI": {
      "type": "string",
      "format": "uri",
      "pattern": "^(?:https://|http://(?:127(?:\\.[0-9]{1,3}){3}|\\[::1\\])(?::[0-9]{1,5})?/)[^?#]*$"
    },
    "GOOGLE_OAUTH_CLIENT_ID": { "type": "string", "minLength": 1, "maxLength": 512 },
    "GOOGLE_OAUTH_CLIENT_SECRET": { "type": "string", "minLength": 16, "maxLength": 8192, "writeOnly": true },
    "GOOGLE_OAUTH_REDIRECT_URI": {
      "type": "string",
      "format": "uri",
      "pattern": "^(?:https://|http://(?:127(?:\\.[0-9]{1,3}){3}|\\[::1\\])(?::[0-9]{1,5})?/)[^?#]*$"
    },
    "SESAME_BINARY": { "type": "string", "minLength": 1 },
    "SESAME_DEPLOYMENT": { "type": "string", "minLength": 1 },
    "SESAME_ISSUER": { "type": "string", "format": "uri", "pattern": "^https://" },
    "SESAME_REDIRECT_URI": { "type": "string", "format": "uri", "pattern": "^https://" },
    "SESAME_SESSION_LIFETIME": { "$ref": "#/$defs/duration", "default": "12h" },
    "SESAME_REQUEST_TIMEOUT": { "$ref": "#/$defs/duration", "default": "10s" },
    "INBOUND_WEBHOOK_SECRET": { "$ref": "#/$defs/secret" },
    "CADUCEUS_AUTH_POLICY": {
      "enum": ["passkey-first", "password-and-passkey"],
      "default": "passkey-first"
    },
    "MAIL_SERVER_ENABLED": { "$ref": "#/$defs/boolean", "default": "false" },
    "MAIL_HOSTNAME": { "type": "string", "minLength": 1 },
    "SMTP_INBOUND_HOST": { "type": "string", "default": "0.0.0.0" },
    "SMTP_INBOUND_PORT": { "$ref": "#/$defs/port", "default": "25" },
    "SMTP_MAX_SIZE": { "$ref": "#/$defs/positiveInteger", "default": "26214400" },
    "MAIL_AUTH_VERIFY": { "enum": ["on", "off"], "default": "on" },
    "MAIL_SUBMISSION_ENABLED": { "$ref": "#/$defs/boolean", "default": "false" },
    "SMTP_SUBMISSION_HOST": { "type": "string", "default": "0.0.0.0" },
    "SMTP_SUBMISSION_PORT": { "$ref": "#/$defs/port", "default": "587" },
    "SMTP_SUBMISSION_TLS_PORT": { "$ref": "#/$defs/port" },
    "SMTP_ADAPTER": { "enum": ["direct", "console"], "default": "direct" },
    "SMTP_TLS_POLICY": { "enum": ["opportunistic", "require"], "default": "opportunistic" },
    "SMTP_FROM": { "type": "string", "format": "email" },
    "DKIM_DOMAIN": { "type": "string" },
    "DKIM_SELECTOR": { "type": "string" },
    "DKIM_PRIVATE_KEY": { "$ref": "#/$defs/secret" },
    "DKIM_PRIVATE_KEY_FILE": { "type": "string" },
    "MAIL_TLS_CERT": { "$ref": "#/$defs/secret" },
    "MAIL_TLS_KEY": { "$ref": "#/$defs/secret" },
    "MAIL_TLS_CERT_FILE": { "type": "string" },
    "MAIL_TLS_KEY_FILE": { "type": "string" },
    "MAIL_TLS_DIR": { "type": "string" },
    "MAIL_ACME_ENABLED": { "$ref": "#/$defs/boolean", "default": "false" },
    "MAIL_ACME_EMAIL": { "type": "string", "format": "email" },
    "MAIL_ACME_STAGING": { "$ref": "#/$defs/boolean", "default": "false" },
    "MAIL_ACME_HTTP_PORT": { "$ref": "#/$defs/port", "default": "80" },
    "MAIL_ACME_ACCOUNT_FILE": { "type": "string" },
    "OUTBOUND_QUEUE_WORKER": { "enum": ["on", "off"], "default": "on" },
    "OUTBOUND_QUEUE_INTERVAL_MS": { "$ref": "#/$defs/positiveInteger", "default": "30000" },
    "OUTBOUND_QUEUE_TIMEOUT_MS": { "$ref": "#/$defs/positiveInteger", "default": "60000" },
    "SNOOZE_WORKER": { "enum": ["on", "off"], "default": "on" },
    "SNOOZE_INTERVAL_MS": { "$ref": "#/$defs/positiveInteger", "default": "30000" },
    "SNOOZE_TIMEOUT_MS": { "$ref": "#/$defs/positiveInteger", "default": "60000" },
    "REMINDER_WORKER": { "enum": ["on", "off"], "default": "on" },
    "REMINDER_INTERVAL_MS": { "$ref": "#/$defs/positiveInteger", "default": "30000" },
    "REMINDER_TIMEOUT_MS": { "$ref": "#/$defs/positiveInteger", "default": "60000" },
    "MAIL_STATUS_INTERVAL_MS": { "$ref": "#/$defs/nonNegativeInteger", "default": "300000" },
    "SPAM_FILTER_DISABLED": { "$ref": "#/$defs/boolean", "default": "false" },
    "SPAM_SCORE_THRESHOLD": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$", "default": "5" },
    "WEB_PUSH_DISABLED": { "$ref": "#/$defs/boolean", "default": "false" },
    "VAPID_PUBLIC_KEY": { "type": "string" },
    "VAPID_PRIVATE_KEY": { "$ref": "#/$defs/secret" },
    "VAPID_SUBJECT": { "type": "string" },
    "STREAM_MAX_MS": { "$ref": "#/$defs/positiveInteger", "default": "25000" },
    "STREAM_POLL_MS": { "$ref": "#/$defs/positiveInteger", "default": "2000" },
    "STREAM_REPLAY_LIMIT": { "$ref": "#/$defs/positiveInteger", "default": "50" },
    "NODE_ENV": { "enum": ["development", "test", "production"] },
    "CADUCEUS_ENABLE_TEST_ROUTES": { "$ref": "#/$defs/boolean", "default": "false" }
  },
  "additionalProperties": false,
  "$defs": {
    "boolean": { "enum": ["true", "false"] },
    "port": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
    },
    "positiveInteger": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "nonNegativeInteger": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)$" },
    "duration": { "type": "string", "pattern": "^[1-9][0-9]*(?:\\.[0-9]+)?(?:ms|s|m|h)$" },
    "secret": { "type": "string", "minLength": 16, "writeOnly": true },
    "bridgeSecret": { "type": "string", "minLength": 32, "writeOnly": true },
    "credentialKeyring": {
      "type": "string",
      "minLength": 1,
      "writeOnly": true,
      "description": "JSON object mapping positive integer key versions to base64-encoded 32-byte AES keys"
    }
  }
}
