{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caduceus.del.ma/contracts/fylo/bridge.v1.schema.json",
  "title": "CADUCEUS private FYLO bridge frame",
  "type": "object",
  "required": ["version", "timestamp", "nonce", "payload", "signature"],
  "properties": {
    "version": { "const": 1 },
    "timestamp": { "type": "integer", "minimum": 0 },
    "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22,64}$" },
    "payload": { "type": "string", "minLength": 4 },
    "signature": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
