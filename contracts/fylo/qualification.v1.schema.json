{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caduceus.del.ma/contracts/fylo/qualification.v1.schema.json",
  "title": "CADUCEUS FYLO qualification evidence",
  "type": "object",
  "required": [
    "schemaVersion",
    "runtimeVersion",
    "protocolVersion",
    "releaseCommit",
    "buildTarget",
    "checks",
    "limits"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runtimeVersion": { "type": "string", "minLength": 1 },
    "protocolVersion": { "const": 1 },
    "releaseCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "buildTarget": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "limits": {
      "type": "object",
      "required": [
        "maxRequestBytes",
        "maxResponseBytes",
        "maxAttachmentBytes",
        "attachmentQuotaBytes"
      ],
      "properties": {
        "maxRequestBytes": { "type": "integer", "minimum": 256 },
        "maxResponseBytes": { "type": "integer", "minimum": 1024 },
        "maxAttachmentBytes": { "type": "integer", "minimum": 1 },
        "attachmentQuotaBytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
