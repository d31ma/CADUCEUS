{
  "contractVersion": "v1",
  "canonicalPrefix": "/api/v1",
  "legacyCompatibility": {
    "prefix": "",
    "supportedThroughMigrationPhase": 7,
    "removalRequires": "one announced release and telemetry showing no supported client dependency"
  },
  "transport": {
    "request": "application/json unless noted",
    "response": "application/json unless noted",
    "errors": "../errors/v1.json",
    "authentication": {
      "bearer": "Authorization: Bearer <token>",
      "hmac": "X-Caduceus-Signature: hex(HMAC-SHA256(secret, exact JSON body))",
      "session": "short-lived transaction identifier in the request body",
      "capability": "Authorization: Bearer <one-time-disclosed MCP capability>",
      "public": "no credential"
    }
  },
  "operations": {
    "listener": "127.0.0.1:9090 by default; non-loopback binds are rejected",
    "routes": [
      { "path": "/healthz", "methods": ["GET"], "purpose": "process liveness" },
      { "path": "/readyz", "methods": ["GET"], "purpose": "dependency and listener readiness" },
      { "path": "/metrics", "methods": ["GET"], "purpose": "Prometheus metrics" }
    ]
  },
  "routes": [
    { "path": "/health", "methods": ["GET"], "auth": "public", "owner": "runtime" },
    { "path": "/system", "methods": ["GET"], "auth": "public", "owner": "runtime" },

    { "path": "/api/v1/provider-catalog", "methods": ["GET"], "auth": "bearer", "owner": "accounts" },
