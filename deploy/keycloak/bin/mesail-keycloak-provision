#!/usr/bin/env bash
set -Eeuo pipefail

readonly KEYCLOAK_HOME=${KEYCLOAK_HOME:-/opt/keycloak}
readonly KCADM=${KEYCLOAK_HOME}/bin/kcadm.sh
readonly SERVER=${MESAIL_KEYCLOAK_ADMIN_URL:-http://127.0.0.1:${KC_HTTP_PORT:-8180}/idp}
readonly DIRECTORY_CLIENT=${MESAIL_KEYCLOAK_DIRECTORY_CLIENT_ID:-mesail-directory}
readonly DIRECTORY_ROLE=create-realm
readonly ADMIN_API_SCOPE=kc-admin-api
readonly CONFIG_ERROR=64
KCADM_CONFIG=$(mktemp)
readonly KCADM_CONFIG

log() {
  printf '[mesail-keycloak-provision] %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2
}

fail() {
  log "ERROR: $*"
  exit "$CONFIG_ERROR"
}

kcadm() {
  "$KCADM" "$@" --config "$KCADM_CONFIG"
}

sign_in() {
  kcadm config credentials --server "$SERVER" --realm master --client "$1" --secret "$2" >/dev/null 2>&1
}

directory_client_works() {
  sign_in "$DIRECTORY_CLIENT" "$MESAIL_KEYCLOAK_DIRECTORY_SECRET"
}

sign_in_as_bootstrap_admin() {
  [[ -n ${KC_BOOTSTRAP_ADMIN_CLIENT_ID:-} && -n ${KC_BOOTSTRAP_ADMIN_CLIENT_SECRET:-} ]] \
    || fail "client ${DIRECTORY_CLIENT} does not exist yet; set KC_BOOTSTRAP_ADMIN_CLIENT_ID and KC_BOOTSTRAP_ADMIN_CLIENT_SECRET for this start"
  sign_in "$KC_BOOTSTRAP_ADMIN_CLIENT_ID" "$KC_BOOTSTRAP_ADMIN_CLIENT_SECRET" || fail "the bootstrap admin client could not sign in"
}

create_directory_client() {
  kcadm create clients -r master -s clientId="$DIRECTORY_CLIENT" -s enabled=true -s publicClient=false \
    -s serviceAccountsEnabled=true -s standardFlowEnabled=false -s directAccessGrantsEnabled=false \
    -s implicitFlowEnabled=false -s secret="$MESAIL_KEYCLOAK_DIRECTORY_SECRET" \
    -s 'description=Lets the directory service create a realm for each new mail domain.' >/dev/null 2>&1
  kcadm add-roles -r master --uusername "service-account-${DIRECTORY_CLIENT}" --rolename "$DIRECTORY_ROLE"
  add_admin_api_scope
  log "created master-realm client ${DIRECTORY_CLIENT} with role ${DIRECTORY_ROLE} and scope ${ADMIN_API_SCOPE}"
}

print_when_named() {
  if [[ $2 == "$3" ]]; then
    echo "$1"
  fi
}

scope_id_named() {
  local id name
  while IFS=, read -r id name; do
    print_when_named "$id" "$name" "$1"
  done < <(kcadm get client-scopes -r master --fields id,name --format csv --noquotes)
}

add_admin_api_scope() {
  local client_id scope_id
  client_id=$(kcadm get clients -r master -q clientId="$DIRECTORY_CLIENT" --fields id --format csv --noquotes)
  scope_id=$(scope_id_named "$ADMIN_API_SCOPE")
  [[ -n $scope_id ]] || fail "client scope ${ADMIN_API_SCOPE} not found in the master realm"
  kcadm update "clients/${client_id}/default-client-scopes/${scope_id}" -r master
}

main() {
  trap 'rm -f "$KCADM_CONFIG"' EXIT
  [[ -n ${MESAIL_KEYCLOAK_DIRECTORY_SECRET:-} ]] || { log "MESAIL_KEYCLOAK_DIRECTORY_SECRET is not set; no admin API client for the directory service"; return 0; }
  directory_client_works && { log "client ${DIRECTORY_CLIENT} is ready"; return 0; }
  sign_in_as_bootstrap_admin
  create_directory_client
  directory_client_works || fail "client ${DIRECTORY_CLIENT} was created but cannot sign in"
}

main "$@"
