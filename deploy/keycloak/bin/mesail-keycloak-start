#!/usr/bin/env bash
set -Eeuo pipefail

readonly KEYCLOAK_HOME=${KEYCLOAK_HOME:-/opt/keycloak}
readonly MESAIL_KEYCLOAK_HOME=${MESAIL_KEYCLOAK_HOME:-/opt/mesail/keycloak}
readonly REALM_SOURCE=${MESAIL_KEYCLOAK_IMPORT_DIR:-${MESAIL_KEYCLOAK_HOME}/realm}
readonly IMPORT_DIR=${KEYCLOAK_HOME}/data/import
readonly MESAIL_REALM_FILE=mesail-realm.json
readonly MESAIL_DEV_USERS='mesail-users-*.json'
readonly DEFAULT_KEYCLOAK_URL=http://127.0.0.1:8180/idp
readonly DEFAULT_PASSKEY_RP_ID=localhost
readonly SQLITE_OPTIONS='journal_mode=WAL&synchronous=NORMAL&busy_timeout=15000&transaction_mode=IMMEDIATE'
readonly CONFIG_ERROR=64

log() {
  printf '[mesail-keycloak] %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2
}

fail() {
  log "ERROR: $*"
  exit "$CONFIG_ERROR"
}

require() {
  local name=$1
  [[ -n ${!name:-} ]] || fail "$name is not set"
}

copy_mesail_realm() {
  cp "$REALM_SOURCE/$MESAIL_REALM_FILE" "$IMPORT_DIR/"
  log "realm mesail: ready to import (skipped if it exists)"
}

copy_dev_users() {
  local files
  [[ ${MESAIL_KEYCLOAK_DEV_USERS:-false} == true ]] || return 0
  log "WARNING: MESAIL_KEYCLOAK_DEV_USERS=true imports the dev-only test users. Never set it in production."
  # shellcheck disable=SC2206
  files=("$REALM_SOURCE"/dev/$MESAIL_DEV_USERS)
  cp "${files[@]}" "$IMPORT_DIR/"
}

prepare_import() {
  rm -rf "$IMPORT_DIR"
  mkdir -p "$IMPORT_DIR"
  copy_mesail_realm
  copy_dev_users
}

choose_passkey_relying_party() {
  if [[ -z ${MESAIL_PASSKEY_RP_ID:-} ]]; then
    log "WARNING: MESAIL_PASSKEY_RP_ID is not set; passkeys use ${DEFAULT_PASSKEY_RP_ID} (set it to the install's public host name)"
  fi
  export MESAIL_PASSKEY_RP_ID=${MESAIL_PASSKEY_RP_ID:-$DEFAULT_PASSKEY_RP_ID}
  log "passkey relying party id: ${MESAIL_PASSKEY_RP_ID} (used when the realm is imported)"
}

use_sqlite() {
  local data_dir=${MESAIL_KEYCLOAK_DATA:-/data/keycloak}
  mkdir -p "$data_dir"
  [[ -w $data_dir ]] || fail "$data_dir is not writable by uid $(id -u)"
  export KC_DB_URL="jdbc:sqlite:${data_dir}/keycloak.db?${SQLITE_OPTIONS}"
  log "database: SQLite file ${data_dir}/keycloak.db"
}

use_postgres() {
  require KC_DB_URL
  log "database: PostgreSQL"
}

choose_database() {
  case ${MESAIL_KEYCLOAK_DB:-sqlite} in
    sqlite) use_sqlite ;;
    postgres) use_postgres ;;
    *) fail "MESAIL_KEYCLOAK_DB must be sqlite or postgres, not ${MESAIL_KEYCLOAK_DB}" ;;
  esac
}

main() {
  require MESAIL_IDENTITY_CLIENT_SECRET
  require MESAIL_ACCOUNT_CLIENT_SECRET
  require MESAIL_KEYCLOAK_DIRECTORY_SECRET
  export KC_HOSTNAME=${MESAIL_KEYCLOAK_URL:-$DEFAULT_KEYCLOAK_URL}
  choose_database
  choose_passkey_relying_party
  prepare_import
  log "issuer: ${KC_HOSTNAME}/realms/mesail"
  exec "$KEYCLOAK_HOME/bin/kc.sh" start --optimized --import-realm "$@"
}

main "$@"
