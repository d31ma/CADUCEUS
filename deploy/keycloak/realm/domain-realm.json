{
  "realm": "${MESAIL_REALM}",
  "displayName": "${MESAIL_REALM}",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "defaultSignatureAlgorithm": "RS256",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "accessTokenLifespan": 60,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "mesail-member",
        "description": "A member of this mail domain. Every user gets it."
      },
      {
        "name": "mesail-admin",
        "description": "Admin of this mail domain."
      },
      {
        "name": "mesail-service",
        "description": "A Mesail service calling another service."
      },
      {
        "name": "default-roles-${MESAIL_REALM}",
        "description": "Roles every new user gets.",
        "composite": true,
        "composites": {
          "realm": [
            "mesail-member"
          ]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-${MESAIL_REALM}",
    "composite": true,
    "clientRole": false
  },
  "clients": [
    {
      "clientId": "mesail-identity",
      "name": "Mesail identity service",
      "description": "The only client that signs users in: the identity service, server to server, with the password grant. Keycloak asks for a TOTP code when the user has one.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${MESAIL_IDENTITY_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "attributes": {
        "use.refresh.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "mesail-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "mesail-api",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "mesail-identity audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "mesail-identity",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "mesail-service",
      "name": "Mesail services",
      "description": "Client credentials for service-to-service calls.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${MESAIL_SERVICE_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "mesail-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "mesail-api",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "mesail-account",
      "name": "Mesail account settings",
      "description": "The identity service changes a user's own password, TOTP and sessions through the admin API of this realm. Client credentials only; its service account may only view and manage users.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${MESAIL_ACCOUNT_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "roles",
        "kc-admin-api"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "mesail-api",
      "name": "Mesail API",
      "description": "The audience of every Mesail access token. No sign-in.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "users": [
    {
      "username": "service-account-mesail-service",
      "enabled": true,
      "serviceAccountClientId": "mesail-service",
      "realmRoles": [
        "mesail-service"
      ]
    },
    {
      "username": "service-account-mesail-account",
      "enabled": true,
      "serviceAccountClientId": "mesail-account",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "manage-users"
        ]
      }
    }
  ]
}
