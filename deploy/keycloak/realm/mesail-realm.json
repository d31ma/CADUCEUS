{
  "realm": "mesail",
  "displayName": "Mesail",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": true,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "rememberMe": false,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "defaultSignatureAlgorithm": "RS256",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyCodeReusable": false,
  "webAuthnPolicyPasswordlessRpEntityName": "Mesail",
  "webAuthnPolicyPasswordlessSignatureAlgorithms": [
    "ES256",
    "RS256"
  ],
  "webAuthnPolicyPasswordlessRpId": "${MESAIL_PASSKEY_RP_ID}",
  "webAuthnPolicyPasswordlessAttestationConveyancePreference": "none",
  "webAuthnPolicyPasswordlessAuthenticatorAttachment": "not specified",
  "webAuthnPolicyPasswordlessResidentKey": "Required",
  "webAuthnPolicyPasswordlessUserVerificationRequirement": "required",
  "webAuthnPolicyPasswordlessCreateTimeout": 120,
  "webAuthnPolicyPasswordlessAvoidSameAuthenticatorRegister": true,
  "webAuthnPolicyPasswordlessAcceptableAaguids": [],
  "webAuthnPolicyPasswordlessExtraOrigins": [],
  "accessTokenLifespan": 60,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "directGrantFlow": "mesail direct grant",
  "authenticationFlows": [
    {
      "alias": "mesail direct grant",
      "description": "The identity service signs a person in: with a passkey when it sends one (passkey_assertion), else with the username, the password and, when set up, the 2-step code (ADR 0008).",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "mesail-passkey-grant",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "mesail password",
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "mesail password",
      "description": "Username, password and, when the person has one, the 2-step code.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "direct-grant-validate-username",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "direct-grant-validate-password",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "mesail password otp",
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 30,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "mesail password otp",
      "description": "The 2-step code, only when the person has one.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-configured",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "direct-grant-validate-otp",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "mesail-operator",
        "description": "Runs the Mesail installation. Given to each operator explicitly."
      },
      {
        "name": "default-roles-mesail",
        "description": "No roles: membership and domain admin rights are directory data (ADR 0005).",
        "composite": true,
        "composites": {
          "realm": []
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-mesail",
    "composite": true,
    "clientRole": false
  },
  "requiredActions": [
    {
      "alias": "VERIFY_PROFILE",
      "name": "Verify Profile",
      "providerId": "VERIFY_PROFILE",
      "enabled": false,
      "defaultAction": false,
      "priority": 90,
      "config": {}
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":1,\"max\":64},\"pattern\":{\"pattern\":\"^(?!.*\\\\.\\\\.)[a-z0-9]([a-z0-9._-]{0,62}[a-z0-9])?$\",\"error-message\":\"A username is the email prefix: 1 to 64 of a-z, 0-9, '.', '_' and '-', starting and ending with a letter or digit, no two dots in a row.\"}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"mesail.mustChangePassword\",\"displayName\":\"Must change the password\",\"validations\":{\"options\":{\"options\":[\"true\",\"false\"]}},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"mesail.addRequest\",\"displayName\":\"Directory add request\",\"validations\":{\"length\":{\"max\":64}},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"mesail.passkeyLastUsed\",\"displayName\":\"Passkeys last used\",\"validations\":{\"length\":{\"max\":80}},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":true}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "mesail-identity",
      "name": "Mesail identity service",
      "description": "The only client that signs people in: the identity service, server to server, with the password grant. Keycloak asks for a TOTP code when the person has one. Its tokens never leave the identity service (ADR 0005).",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${MESAIL_IDENTITY_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "attributes": {
        "use.refresh.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "mesail-identity audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "mesail-identity",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "must change password",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "mesail.mustChangePassword",
            "claim.name": "mesail_must_change_password",
            "jsonType.label": "boolean",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "multivalued": "false",
            "aggregate.attrs": "false"
          }
        }
      ]
    },
    {
      "clientId": "mesail-account",
      "name": "Mesail account settings",
      "description": "The identity service changes a person's own password, TOTP and sessions through the admin API of this realm. Its service account may only view and manage users.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${MESAIL_ACCOUNT_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "roles",
        "kc-admin-api"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "mesail-directory",
      "name": "Mesail directory",
      "description": "The directory service creates, disables and deletes people and resets their credentials through the admin API of this realm. Its service account may only view, query and manage users.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${MESAIL_KEYCLOAK_DIRECTORY_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "roles",
        "kc-admin-api"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "service-account-mesail-account",
      "enabled": true,
      "serviceAccountClientId": "mesail-account",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "manage-users"
        ]
      }
    },
    {
      "username": "service-account-mesail-directory",
      "enabled": true,
      "serviceAccountClientId": "mesail-directory",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "query-users",
          "manage-users"
        ]
      }
    }
  ]
}
