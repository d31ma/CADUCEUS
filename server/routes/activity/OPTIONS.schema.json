{
  "GET": {
    "200": {
      "events": ["^.*$"],
      "unseenCount": "^\\d+$",
      "metrics": {
        "sent": "^\\d+$",
        "received": "^\\d+$",
        "tracked": "^\\d+$",
        "opened": "^\\d+$",
        "clicked": "^\\d+$",
        "replied": "^\\d+$",
        "trackingRate": "^\\d+(\\.\\d+)?$",
        "openRate": "^\\d+(\\.\\d+)?$",
        "clickRate": "^\\d+(\\.\\d+)?$",
        "replyRate": "^\\d+(\\.\\d+)?$",
        "bySubject": ["^.*$"],
        "daily": ["^.*$"]
      },
      "generatedAt": "^.*$"
    },
    "400": { "error": "^.*$" },
    "401": { "error": "^.*$", "unauthorized": "^(true|false)$" }
  }
}
