{
  "POST": {
    "200": {
      "id": "^ext_[A-Za-z0-9_-]{20,80}$",
      "provider": "^gmail$",
      "mailboxAddress": "^.*@.*$",
      "authIdentity": "^.*@.*$",
      "sharedMailboxAddress": "^.*$",
      "label": "^.+$",
      "color": "^#[0-9A-Fa-f]{6}$",
      "order": "^\\d+$",
      "state": "^(ready|syncing|idle)$",
      "connection": "^.*$",
      "capabilities": "^.*$",
      "progress": "^.*$",
      "failure": "^.*$",
      "revision": "^[1-9]\\d*$",
      "createdAt": "^.*$",
      "updatedAt": "^.*$"
    },
    "400": { "error": "^.*$" },
    "401": { "error": "^.*$", "unauthorized": "^(true|false)$" },
    "409": { "error": "^.*$", "conflict": "^(true|false)$" },
    "422": { "error": "^.*$", "blocked": ["^.*$"] },
    "503": { "error": "^.*$", "unavailable": "^(true|false)$" }
  }
}
