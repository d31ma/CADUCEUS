{
  "POST": {
    "200": {
      "credentialId": "^.*$",
      "principalId": "^.*$",
      "tenantId": "^.*$",
      "publicKey": "^.*$",
      "signCount": "^-?[0-9]+$",
      "userVerified": "^(true|false)$",
      "registeredAt": "^.*$"
    },
    "400": {
      "error": "^.*$"
    },
    "401": {
      "error": "^.*$",
      "unauthorized": "^(true|false)$"
    },
    "403": {
      "error": "^.*$",
      "forbidden": "^(true|false)$"
    },
    "409": {
      "error": "^.*$",
      "conflict": "^(true|false)$"
    },
    "429": {
      "error": "^.*$",
      "retryAfterSeconds": "^-?[0-9]+(?:\\.[0-9]+)?$",
      "rateLimited": "^(true|false)$"
    },
    "503": {
      "error": "^.*$",
      "unavailable": "^(true|false)$"
    }
  }
}
