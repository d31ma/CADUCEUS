{
  "POST": {
    "200": {
      "accessToken": "^.*$",
      "refreshToken": "^.*$",
      "idToken": "^.*$",
      "tokenType": "^.*$",
      "expiresIn": "^-?[0-9]+$",
      "scope": "^.*$",
      "sessionId": "^.*$",
      "principalId": "^.*$",
      "tenantId": "^.*$",
      "domain": "^.*$",
      "address": "^.*$",
      "assurance": "^.*$"
    },
    "400": {
      "error": "^.*$"
    },
    "401": {
      "error": "^.*$",
      "unauthorized": "^(true|false)$"
    },
    "403": {
      "error": "^.*$",
      "forbidden": "^(true|false)$"
    },
    "409": {
      "error": "^.*$",
      "conflict": "^(true|false)$"
    },
    "429": {
      "error": "^.*$",
      "retryAfterSeconds": "^-?[0-9]+(?:\\.[0-9]+)?$",
      "rateLimited": "^(true|false)$"
    },
    "503": {
      "error": "^.*$",
      "unavailable": "^(true|false)$"
    }
  }
}
