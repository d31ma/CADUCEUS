{
  "GET": {
    "200": ["^.*$"],
    "401": { "error": "^.*$", "unauthorized": "^(true|false)$" }
  },
  "POST": {
    "200": { "id": "^.*$", "displayName": "^.*$", "version": "^.*$", "kind": "^(plugin|theme)$", "digest": "^[a-f0-9]{64}$", "enabled": "^(true|false)$" },
    "400": { "error": "^.*$" },
    "401": { "error": "^.*$", "unauthorized": "^(true|false)$" },
    "409": { "error": "^.*$", "conflict": "^(true|false)$" }
  }
}
