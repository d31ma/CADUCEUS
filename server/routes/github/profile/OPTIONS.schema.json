{
  "GET": {
    "200": {
      "enabled": "^(true|false)$",
      "status": "^(disabled|found|not-found|unavailable)$",
      "profile?": {
        "login": "^.*$",
        "profileUrl": "^https://github\\.com/.*$",
        "repositories": [{
          "name": "^.*$",
          "fullName": "^.*$",
          "url": "^https://github\\.com/.*$",
          "description": "^.*$",
          "language": "^.*$",
          "stars": "^\\d+$"
        }]
      }
    },
    "400": { "error": "^.*$" },
    "401": { "error": "^.*$", "unauthorized": "^(true|false)$" },
    "404": { "error": "^.*$", "notFound": "^(true|false)$" }
  }
}
