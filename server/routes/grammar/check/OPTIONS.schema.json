{
  "POST": {
    "200": {
      "language": "^(auto|en-US|en-GB)$",
      "detectedLanguage": "^(und|en-US|en-GB)$",
      "matches": [{
        "offset": "^\\d+$",
        "length": "^\\d+$",
        "message": "^.*$",
        "shortMessage": "^.*$",
        "replacements": ["^.*$"],
        "ruleId": "^[A-Z0-9_-]{1,64}$",
        "ruleDescription": "^.*$",
        "category": "^[A-Z]+$",
        "categoryName": "^.*$",
        "issueType": "^.*$",
        "context": { "text": "^.*$", "offset": "^\\d+$", "length": "^\\d+$" }
      }]
    },
    "400": { "error": "^.*$" },
    "401": { "error": "^.*$", "unauthorized": "^(true|false)$" },
    "429": { "error": "^.*$", "retryAfterSeconds": "^\\d+$", "rateLimited": "^(true|false)$" }
  }
}
