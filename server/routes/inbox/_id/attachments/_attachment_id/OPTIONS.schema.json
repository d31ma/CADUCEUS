{
  "GET": {
    "200": {
      "id": "^.*$",
      "filename": "^.*$",
      "contentType": "^.*$",
      "size": "^-?[0-9]+(?:\\.[0-9]+)?$",
      "contentBase64": "^.*$"
    },
    "401": {
      "error": "^.*$",
      "unauthorized": "^(true|false)$"
    },
    "403": {
      "error": "^.*$",
      "forbidden": "^(true|false)$"
    },
    "404": {
      "error": "^.*$",
      "notFound": "^(true|false)$"
    }
  }
}
