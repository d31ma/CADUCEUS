{
  "POST": {
    "200": {
      "images": [
        {
          "url": "^https?://.*$",
          "contentType": "^image/(png|jpeg|gif|webp|avif)$",
          "contentBase64": "^.*$",
          "size": "^\\d+$"
        }
      ],
      "failed": "^\\d+$"
    },
    "400": {
      "error": "^.*$"
    },
    "401": {
      "error": "^.*$",
      "unauthorized": "^(true|false)$"
    },
    "403": {
      "error": "^.*$",
      "forbidden": "^(true|false)$"
    },
    "404": {
      "error": "^.*$",
      "notFound": "^(true|false)$"
    },
    "429": {
      "error": "^.*$",
      "retryAfterSeconds": "^\\d+$",
      "rateLimited": "^(true|false)$"
    }
  }
}
