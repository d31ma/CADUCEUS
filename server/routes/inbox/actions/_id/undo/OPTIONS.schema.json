{
  "POST": {
    "200": {
      "actionId": "^.+$",
      "status": "^undone$",
      "kind": "^(archive|move|label|trash|mark-read|mark-unread|star|unstar|bulk)$",
      "count": "^\\d+$",
      "expiresAt": "^.*$",
      "emails": [{
        "id": "^.*$",
        "domain": "^.*$",
        "folder": "^.*$",
        "labels?": ["^.*$"],
        "systemFolder?": "^.*$",
        "external?": "^(true|false)$",
        "providerAccountId?": "^.*$",
        "read": "^(true|false)$",
        "starred": "^(true|false)$"
      }]
    },
    "401": { "error": "^.*$", "unauthorized": "^(true|false)$" },
    "404": { "error": "^.*$", "notFound": "^(true|false)$" },
    "409": { "error": "^.*$", "conflict": "^(true|false)$" },
    "503": { "error": "^.*$", "unavailable": "^(true|false)$" }
  }
}
