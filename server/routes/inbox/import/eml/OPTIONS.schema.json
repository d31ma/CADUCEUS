{
  "POST": {
    "200": {
      "imported": "^(true|false)$",
      "id": "^.*$",
      "subject": "^.*$",
      "sender": "^.*$",
      "receivedAt": "^.*$",
      "attachmentCount": "^\\d+$"
    },
    "400": {
      "error": "^.*$"
    },
    "401": {
      "error": "^.*$",
      "unauthorized": "^(true|false)$"
    },
    "403": {
      "error": "^.*$",
      "forbidden": "^(true|false)$"
    },
    "503": {
      "error": "^.*$",
      "unavailable": "^(true|false)$"
    }
  }
}
