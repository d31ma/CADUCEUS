{
  "POST": {
    "200": {
      "token": "^mcp1\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]{43}$",
      "tokenId": "^mcp-token-[A-Za-z0-9_-]{20,40}$",
      "createdAt": "^\\d{4}-\\d{2}-\\d{2}T.+Z$"
    },
    "401": { "error": "^.*$", "unauthorized": "^(true|false)$" },
    "404": { "error": "^.*$", "notFound": "^(true|false)$" }
  },
  "DELETE": {
    "200": { "revoked": "^(true|false)$" },
    "401": { "error": "^.*$", "unauthorized": "^(true|false)$" }
  }
}
