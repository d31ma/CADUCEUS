{
  "POST": {
    "200": {
      "messageId": "^.*$",
      "sent": "^(true|false)$",
      "queued": "^(true|false)$",
      "queueId": "^sub_[A-Za-z0-9_-]{20,80}$",
      "externalAccountId": "^ext_[A-Za-z0-9_-]{20,80}$",
      "undoId": "^.*$",
      "scheduled": "^(true|false)$",
      "id": "^.*$",
      "reminderId": "^.*$",
      "threadId": "^[a-f0-9]{64}$",
      "archived": "^(true|false)$",
      "archivedCount": "^\\d+$",
      "archiveThreadId": "^.*$",
      "archiveError": "^.*$"
    },
    "400": {
      "error": "^.*$"
    },
    "401": {
      "error": "^.*$",
      "unauthorized": "^(true|false)$"
    },
    "403": {
      "error": "^.*$",
      "forbidden": "^(true|false)$"
    },
    "404": {
      "error": "^.*$",
      "notFound": "^(true|false)$"
    },
    "409": {
      "error": "^.*$",
      "conflict": "^(true|false)$"
    },
    "422": {
      "error": "^.*$",
      "blocked": [
        "^.*$"
      ]
    },
    "429": {
      "error": "^.*$",
      "retryAfterSeconds": "^-?[0-9]+(?:\\.[0-9]+)?$",
      "rateLimited": "^(true|false)$"
    }
  }
}
