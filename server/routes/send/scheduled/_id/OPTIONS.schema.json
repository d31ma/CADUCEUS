{
  "GET": {
    "200": "^.*$",
    "401": { "error": "^.*$", "unauthorized": "^(true|false)$" },
    "404": { "error": "^.*$", "notFound": "^(true|false)$" }
  },
  "PUT": {
    "200": { "scheduled": "^(true|false)$", "id": "^.*$", "threadId": "^[a-f0-9]{64}$", "sendAt": "^.*$" },
    "400": { "error": "^.*$" },
    "401": { "error": "^.*$", "unauthorized": "^(true|false)$" },
    "403": { "error": "^.*$", "forbidden": "^(true|false)$" },
    "404": { "error": "^.*$", "notFound": "^(true|false)$" },
    "409": { "error": "^.*$", "conflict": "^(true|false)$" },
    "422": { "error": "^.*$", "blocked": ["^.*$"] }
  },
  "DELETE": {
    "200": { "cancelled": "^(true|false)$" },
    "401": { "error": "^.*$", "unauthorized": "^(true|false)$" },
    "404": { "error": "^.*$", "notFound": "^(true|false)$" },
    "409": { "error": "^.*$", "conflict": "^(true|false)$" }
  }
}
