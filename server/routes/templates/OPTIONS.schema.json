{
  "GET": {
    "200": [
      "^.*$"
    ],
    "401": {
      "error": "^.*$",
      "unauthorized": "^(true|false)$"
    }
  },
  "POST": {
    "200": {
      "id": "^.*$",
      "name": "^.*$",
      "subject": "^.*$",
      "text": "^.*$",
      "to": "^.*$",
      "cc": "^.*$",
      "createdAt": "^.*$",
      "updatedAt": "^.*$"
    },
    "400": {
      "error": "^.*$"
    },
    "401": {
      "error": "^.*$",
      "unauthorized": "^(true|false)$"
    }
  },
  "DELETE": {
    "200": {
      "deleted": "^(true|false)$"
    },
    "400": {
      "error": "^.*$"
    },
    "401": {
      "error": "^.*$",
      "unauthorized": "^(true|false)$"
    },
    "404": {
      "error": "^.*$",
      "notFound": "^(true|false)$"
    }
  }
