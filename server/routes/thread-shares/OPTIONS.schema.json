{
  "GET": {
    "400": { "error": "^.*$" },
    "401": { "error": "^.*$", "unauthorized": "^(true|false)$" },
    "404": { "error": "^.*$", "notFound": "^(true|false)$" }
  },
  "POST": {
    "200": {
      "id": "^share-[A-Za-z0-9_-]{20,40}$",
      "threadId": "^[\\s\\S]{1,500}$",
      "subject": "^[\\s\\S]{0,500}$",
      "messageCount": "^\\d+$",
      "createdAt": "^\\d{4}-\\d{2}-\\d{2}T.+Z$",
      "expiresAt": "^\\d{4}-\\d{2}-\\d{2}T.+Z$",
      "revokedAt": "^[\\s\\S]*$",
      "active": "^(true|false)$",
      "token": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]{43}$",
      "url": "^/share/[A-Za-z0-9_.~-]+$"
    },
    "400": { "error": "^.*$" },
    "401": { "error": "^.*$", "unauthorized": "^(true|false)$" },
    "404": { "error": "^.*$", "notFound": "^(true|false)$" }
  }
}
