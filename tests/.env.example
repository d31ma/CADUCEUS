# CADUCEUS local test defaults
# Copy to .env if you want to override test secrets:
#   cp tests/.env.example tests/.env

JWT_SECRET=caduceus-local-test-secret
INBOUND_WEBHOOK_SECRET=caduceus-local-inbound-secret
TRACKING_SECRET=caduceus-local-tracking-secret
CADUCEUS_PUBLIC_URL=http://127.0.0.1:9878
SMTP_ADAPTER=console
# Tachyon prewarms route processes on a cold start. Increase this on slower
# or network-synchronized filesystems.
TEST_SERVER_START_TIMEOUT_MS=120000
